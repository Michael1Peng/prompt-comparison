{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLI命令API契约",
  "version": "1.0.0",
  "description": "定义提示词分析CLI工具的命令行接口规范",
  
  "cli": {
    "name": "prompt-analyzer",
    "version": "1.0.0",
    "description": "AI提示词分析和对比工具",
    "author": "Prompt Analysis Team",
    "license": "MIT",
    
    "globalOptions": {
      "config": {
        "alias": ["c"],
        "type": "string",
        "description": "配置文件路径",
        "default": ".prompt-analyzerrc.json"
      },
      "verbose": {
        "alias": ["v"],
        "type": "boolean",
        "description": "详细输出模式",
        "default": false
      },
      "quiet": {
        "alias": ["q"],
        "type": "boolean", 
        "description": "静默模式(只输出错误)",
        "default": false
      },
      "output": {
        "alias": ["o"],
        "type": "string",
        "description": "输出目录",
        "default": "./output"
      },
      "format": {
        "alias": ["f"],
        "type": "string",
        "choices": ["json", "html", "markdown", "csv"],
        "description": "默认输出格式",
        "default": "html"
      },
      "help": {
        "alias": ["h"],
        "type": "boolean",
        "description": "显示帮助信息"
      },
      "version": {
        "type": "boolean", 
        "description": "显示版本信息"
      }
    },
    
    "commands": {
      "scan": {
        "description": "扫描目录中的提示词文件",
        "usage": "prompt-analyzer scan [path] [options]",
        "examples": [
          "prompt-analyzer scan",
          "prompt-analyzer scan ./my-project",
          "prompt-analyzer scan --recursive --extensions .md,.txt"
        ],
        
        "arguments": {
          "path": {
            "type": "string",
            "description": "要扫描的目录路径",
            "default": ".",
            "required": false
          }
        },
        
        "options": {
          "recursive": {
            "alias": ["r"],
            "type": "boolean",
            "description": "递归扫描子目录",
            "default": true
          },
          "extensions": {
            "alias": ["e"],
            "type": "array",
            "description": "要扫描的文件扩展名",
            "default": [".js", ".ts", ".py", ".md", ".txt", ".json", ".yaml", ".yml"]
          },
          "ignore": {
            "alias": ["i"],
            "type": "array",
            "description": "要忽略的文件/目录模式",
            "default": ["node_modules/**", ".git/**", "__pycache__/**"]
          },
          "max-size": {
            "type": "string",
            "description": "最大文件大小(如: 5MB, 10KB)",
            "default": "5MB"
          },
          "concurrency": {
            "type": "number",
            "description": "并发处理数量",
            "default": 10,
            "min": 1,
            "max": 50
          },
          "ai-identify": {
            "type": "boolean",
            "description": "使用AI智能识别提示词文件",
            "default": true
          },
          "ai-provider": {
            "type": "string",
            "choices": ["qwen", "openai", "claude"],
            "description": "AI服务提供商",
            "default": "qwen"
          },
          "confidence": {
            "type": "number",
            "description": "AI识别置信度阈值",
            "default": 0.7,
            "min": 0,
            "max": 1
          }
        },
        
        "output": {
          "type": "object",
          "$ref": "#/definitions/ScanCommandOutput"
        },
        
        "exitCodes": {
          "0": "成功完成扫描",
          "1": "扫描过程中发生错误",
          "2": "路径不存在或无权限",
          "3": "配置错误"
        }
      },
      
      "analyze": {
        "description": "分析提示词的15个框架要素",
        "usage": "prompt-analyzer analyze <input> [options]",
        "examples": [
          "prompt-analyzer analyze ./output/prompts.json",
          "prompt-analyzer analyze prompts.json --batch-size 5 --model qwen-plus",
          "prompt-analyzer analyze prompts.json --retry-failed --output ./analysis"
        ],
        
        "arguments": {
          "input": {
            "type": "string",
            "description": "输入的JSON文件路径(扫描结果)",
            "required": true
          }
        },
        
        "options": {
          "ai-provider": {
            "type": "string",
            "choices": ["qwen", "openai", "claude"],
            "description": "AI服务提供商",
            "default": "qwen"
          },
          "model": {
            "type": "string",
            "description": "使用的AI模型",
            "default": "qwen-plus"
          },
          "batch-size": {
            "alias": ["b"],
            "type": "number",
            "description": "批处理大小",
            "default": 3,
            "min": 1,
            "max": 10
          },
          "concurrency": {
            "alias": ["c"],
            "type": "number",
            "description": "并发分析数量",
            "default": 2,
            "min": 1,
            "max": 5
          },
          "language": {
            "alias": ["l"],
            "type": "string",
            "choices": ["zh", "en", "auto"],
            "description": "分析输出语言",
            "default": "auto"
          },
          "depth": {
            "type": "string",
            "choices": ["basic", "standard", "detailed"],
            "description": "分析深度",
            "default": "standard"
          },
          "retry-count": {
            "type": "number",
            "description": "失败重试次数",
            "default": 2,
            "min": 0,
            "max": 5
          },
          "retry-failed": {
            "type": "boolean",
            "description": "只重新分析之前失败的项目",
            "default": false
          },
          "min-confidence": {
            "type": "number",
            "description": "最低质量要求(低于此值的结果将重试)",
            "default": 0.6,
            "min": 0,
            "max": 1
          },
          "timeout": {
            "type": "number",
            "description": "单次分析超时时间(秒)",
            "default": 45,
            "min": 10,
            "max": 300
          },
          "save-partial": {
            "type": "boolean",
            "description": "保存部分完成的结果",
            "default": true
          }
        },
        
        "output": {
          "type": "object",
          "$ref": "#/definitions/AnalyzeCommandOutput"
        },
        
        "exitCodes": {
          "0": "分析成功完成",
          "1": "分析过程中发生错误",
          "2": "输入文件不存在或格式错误",
          "3": "AI服务不可用",
          "4": "配置错误(如API密钥缺失)"
        }
      },
      
      "translate": {
        "description": "翻译提示词内容到中文",
        "usage": "prompt-analyzer translate <input> [options]",
        "examples": [
          "prompt-analyzer translate prompts.json",
          "prompt-analyzer translate prompts.json --target-lang zh --batch-size 5"
        ],
        
        "arguments": {
          "input": {
            "type": "string",
            "description": "输入的JSON文件路径",
            "required": true
          }
        },
        
        "options": {
          "target-lang": {
            "alias": ["t"],
            "type": "string",
            "choices": ["zh", "en"],
            "description": "目标语言",
            "default": "zh"
          },
          "ai-provider": {
            "type": "string",
            "choices": ["qwen", "openai", "claude"],
            "description": "翻译服务提供商",
            "default": "qwen"
          },
          "model": {
            "type": "string",
            "description": "翻译模型",
            "default": "qwen-coder-plus"
          },
          "batch-size": {
            "alias": ["b"],
            "type": "number",
            "description": "批处理大小",
            "default": 5,
            "min": 1,
            "max": 20
          },
          "skip-translated": {
            "type": "boolean",
            "description": "跳过已翻译的内容",
            "default": true
          },
          "quality-check": {
            "type": "boolean",
            "description": "翻译质量检查",
            "default": true
          }
        },
        
        "output": {
          "type": "object",
          "$ref": "#/definitions/TranslateCommandOutput"
        }
      },
      
      "report": {
        "description": "生成分析报告和对比表格",
        "usage": "prompt-analyzer report <input> [options]",
        "examples": [
          "prompt-analyzer report analyzed-prompts.json",
          "prompt-analyzer report prompts.json --format html --include-charts",
          "prompt-analyzer report prompts.json --table-only --group-by category"
        ],
        
        "arguments": {
          "input": {
            "type": "string",
            "description": "输入的分析结果JSON文件",
            "required": true
          }
        },
        
        "options": {
          "report-type": {
            "alias": ["t"],
            "type": "string",
            "choices": ["summary", "detailed", "executive", "table-only"],
            "description": "报告类型",
            "default": "summary"
          },
          "include-statistics": {
            "type": "boolean",
            "description": "包含统计信息",
            "default": true
          },
          "include-charts": {
            "type": "boolean",
            "description": "包含图表(仅HTML格式)",
            "default": false
          },
          "group-by": {
            "type": "string",
            "choices": ["category", "file", "complexity", "none"],
            "description": "分组方式",
            "default": "none"
          },
          "sort-by": {
            "type": "string",
            "choices": ["name", "confidence", "completeness", "complexity"],
            "description": "排序方式",
            "default": "name"
          },
          "filter": {
            "type": "string",
            "description": "过滤条件(JSON格式)",
            "example": "{\"minConfidence\": 0.8, \"categories\": [\"code-review\"]}"
          },
          "table-layout": {
            "type": "string",
            "choices": ["prompts_as_rows", "prompts_as_columns"],
            "description": "对比表格布局",
            "default": "prompts_as_rows"
          },
          "max-cell-length": {
            "type": "number",
            "description": "表格单元格最大长度",
            "default": 200,
            "min": 50,
            "max": 1000
          },
          "theme": {
            "type": "string",
            "choices": ["default", "dark", "minimal"],
            "description": "HTML主题(仅HTML格式)",
            "default": "default"
          },
          "title": {
            "type": "string",
            "description": "报告标题",
            "default": "Prompt Analysis Report"
          }
        },
        
        "output": {
          "type": "object",
          "$ref": "#/definitions/ReportCommandOutput"
        }
      },
      
      "config": {
        "description": "管理配置设置",
        "usage": "prompt-analyzer config <key> [value] [options]",
        "examples": [
          "prompt-analyzer config --list",
          "prompt-analyzer config ai.provider qwen",
          "prompt-analyzer config ai.qwen.model qwen-plus",
          "prompt-analyzer config --reset"
        ],
        
        "arguments": {
          "key": {
            "type": "string",
            "description": "配置项键名",
            "required": false
          },
          "value": {
            "type": "string",
            "description": "配置项值",
            "required": false
          }
        },
        
        "options": {
          "list": {
            "alias": ["l"],
            "type": "boolean",
            "description": "列出所有配置项",
            "conflicts": ["key", "value"]
          },
          "reset": {
            "type": "boolean",
            "description": "重置配置为默认值",
            "conflicts": ["key", "value", "list"]
          },
          "global": {
            "alias": ["g"],
            "type": "boolean",
            "description": "操作全局配置",
            "default": false
          },
          "file": {
            "type": "string",
            "description": "指定配置文件路径"
          }
        }
      }
    }
  },
  
  "definitions": {
    "ScanCommandOutput": {
      "type": "object",
      "properties": {
        "success": {"type": "boolean"},
        "sessionId": {"type": "string"},
        "startTime": {"type": "string", "format": "date-time"},
        "endTime": {"type": "string", "format": "date-time"},
        "duration": {"type": "integer"},
        "summary": {
          "type": "object",
          "properties": {
            "totalFiles": {"type": "integer"},
            "promptFiles": {"type": "integer"},
            "totalPrompts": {"type": "integer"},
            "errorCount": {"type": "integer"}
          }
        },
        "outputFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "path": {"type": "string"},
              "size": {"type": "integer"}
            }
          }
        },
        "statistics": {
          "type": "object",
          "properties": {
            "filesByExtension": {"type": "object"},
            "averageFileSize": {"type": "number"},
            "processingSpeed": {"type": "number"}
          }
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "errors": {
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "file": {"type": "string"},
              "error": {"type": "string"}
            }
          }
        }
      },
      "required": ["success", "sessionId", "summary"]
    },
    
    "AnalyzeCommandOutput": {
      "type": "object",
      "properties": {
        "success": {"type": "boolean"},
        "sessionId": {"type": "string"},
        "startTime": {"type": "string", "format": "date-time"},
        "endTime": {"type": "string", "format": "date-time"},
        "duration": {"type": "integer"},
        "summary": {
          "type": "object",
          "properties": {
            "totalPrompts": {"type": "integer"},
            "analyzedSuccessfully": {"type": "integer"},
            "analysisFailed": {"type": "integer"},
            "averageConfidence": {"type": "number"},
            "averageCompleteness": {"type": "number"}
          }
        },
        "outputFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "path": {"type": "string"},
              "size": {"type": "integer"}
            }
          }
        },
        "performance": {
          "type": "object",
          "properties": {
            "totalApiCalls": {"type": "integer"},
            "averageResponseTime": {"type": "number"},
            "totalTokensUsed": {"type": "integer"},
            "estimatedCost": {"type": "number"}
          }
        },
        "qualityMetrics": {
          "type": "object",
          "properties": {
            "highQualityCount": {"type": "integer"},
            "mediumQualityCount": {"type": "integer"},
            "lowQualityCount": {"type": "integer"}
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "promptId": {"type": "string"},
              "promptName": {"type": "string"},
              "error": {"type": "string"}
            }
          }
        }
      },
      "required": ["success", "sessionId", "summary"]
    },
    
    "TranslateCommandOutput": {
      "type": "object",
      "properties": {
        "success": {"type": "boolean"},
        "sessionId": {"type": "string"},
        "summary": {
          "type": "object",
          "properties": {
            "totalPrompts": {"type": "integer"},
            "translatedSuccessfully": {"type": "integer"},
            "translationFailed": {"type": "integer"},
            "skipped": {"type": "integer"},
            "averageConfidence": {"type": "number"}
          }
        },
        "outputFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "path": {"type": "string"}
            }
          }
        },
        "performance": {
          "type": "object",
          "properties": {
            "totalApiCalls": {"type": "integer"},
            "averageResponseTime": {"type": "number"},
            "estimatedCost": {"type": "number"}
          }
        }
      }
    },
    
    "ReportCommandOutput": {
      "type": "object",
      "properties": {
        "success": {"type": "boolean"},
        "reportId": {"type": "string"},
        "reportType": {"type": "string"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "summary": {
          "type": "object",
          "properties": {
            "totalPrompts": {"type": "integer"},
            "sectionsGenerated": {"type": "integer"},
            "tablesGenerated": {"type": "integer"},
            "chartsGenerated": {"type": "integer"}
          }
        },
        "outputFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "format": {"type": "string"},
              "path": {"type": "string"},
              "size": {"type": "integer"}
            }
          }
        },
        "statistics": {
          "type": "object",
          "properties": {
            "processingTime": {"type": "integer"},
            "dataPoints": {"type": "integer"}
          }
        }
      }
    }
  },
  
  "configuration": {
    "schema": {
      "type": "object",
      "properties": {
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["qwen", "openai", "claude"],
              "default": "qwen"
            },
            "qwen": {
              "type": "object", 
              "properties": {
                "apiKey": {"type": "string", "description": "从环境变量DASHSCOPE_API_KEY读取"},
                "model": {"type": "string", "default": "qwen-plus"},
                "baseUrl": {"type": "string", "default": "https://dashscope.aliyuncs.com"}
              }
            },
            "openai": {
              "type": "object",
              "properties": {
                "apiKey": {"type": "string", "description": "从环境变量OPENAI_API_KEY读取"},
                "model": {"type": "string", "default": "gpt-4o-mini"},
                "baseUrl": {"type": "string", "default": "https://api.openai.com/v1"}
              }
            },
            "claude": {
              "type": "object",
              "properties": {
                "apiKey": {"type": "string", "description": "从环境变量ANTHROPIC_API_KEY读取"},
                "model": {"type": "string", "default": "claude-3-haiku-20240307"},
                "baseUrl": {"type": "string", "default": "https://api.anthropic.com"}
              }
            }
          }
        },
        "scan": {
          "type": "object",
          "properties": {
            "extensions": {
              "type": "array",
              "items": {"type": "string"},
              "default": [".js", ".ts", ".py", ".md", ".txt", ".json", ".yaml", ".yml"]
            },
            "ignorePatterns": {
              "type": "array",
              "items": {"type": "string"},
              "default": ["node_modules/**", ".git/**", "__pycache__/**", "dist/**", "build/**"]
            },
            "maxFileSize": {"type": "string", "default": "5MB"},
            "concurrency": {"type": "integer", "default": 10}
          }
        },
        "analyze": {
          "type": "object",
          "properties": {
            "batchSize": {"type": "integer", "default": 3},
            "concurrency": {"type": "integer", "default": 2},
            "retryCount": {"type": "integer", "default": 2},
            "timeout": {"type": "integer", "default": 45000}
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "directory": {"type": "string", "default": "./output"},
            "format": {"type": "string", "default": "html"},
            "overwrite": {"type": "boolean", "default": false}
          }
        }
      }
    }
  }
}