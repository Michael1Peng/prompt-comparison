{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "报告生成服务API契约",
  "version": "1.0.0",
  "description": "定义分析报告和对比表格生成服务的输入输出接口",
  
  "services": {
    "ReportGenerator": {
      "description": "生成提示词分析报告和对比表格",
      
      "methods": {
        "generateSummaryReport": {
          "description": "生成提示词分析摘要报告",
          "input": {
            "type": "object",
            "properties": {
              "prompts": {
                "type": "array",
                "items": {"$ref": "#/definitions/AnalyzedPrompt"},
                "description": "已分析的提示词列表"
              },
              "options": {
                "$ref": "#/definitions/ReportOptions"
              }
            },
            "required": ["prompts"]
          },
          "output": {
            "$ref": "#/definitions/ReportResult"
          },
          "errors": [
            {
              "code": "INSUFFICIENT_DATA",
              "message": "数据不足以生成报告"
            },
            {
              "code": "TEMPLATE_ERROR",
              "message": "报告模板处理错误"
            }
          ]
        },
        
        "generateComparisonTable": {
          "description": "生成提示词要素对比表格",
          "input": {
            "type": "object",
            "properties": {
              "prompts": {
                "type": "array",
                "items": {"$ref": "#/definitions/AnalyzedPrompt"},
                "minItems": 2,
                "description": "要对比的提示词列表"
              },
              "tableOptions": {
                "$ref": "#/definitions/TableOptions"
              }
            },
            "required": ["prompts"]
          },
          "output": {
            "$ref": "#/definitions/TableResult"
          }
        },
        
        "exportToFormat": {
          "description": "将报告导出为指定格式",
          "input": {
            "type": "object",
            "properties": {
              "reportData": {
                "$ref": "#/definitions/ReportData"
              },
              "format": {
                "type": "string",
                "enum": ["html", "markdown", "csv", "json", "pdf"],
                "description": "导出格式"
              },
              "exportOptions": {
                "$ref": "#/definitions/ExportOptions"
              }
            },
            "required": ["reportData", "format"]
          },
          "output": {
            "$ref": "#/definitions/ExportResult"
          }
        },
        
        "generateStatistics": {
          "description": "生成提示词分析统计信息",
          "input": {
            "type": "object",
            "properties": {
              "prompts": {
                "type": "array",
                "items": {"$ref": "#/definitions/AnalyzedPrompt"}
              },
              "statisticsOptions": {
                "$ref": "#/definitions/StatisticsOptions"
              }
            },
            "required": ["prompts"]
          },
          "output": {
            "$ref": "#/definitions/StatisticsResult"
          }
        }
      }
    }
  },
  
  "definitions": {
    "AnalyzedPrompt": {
      "type": "object",
      "properties": {
        "promptId": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "originalContent": {"type": "string"},
        "translatedContent": {"type": "string"},
        "sourceInfo": {
          "type": "object",
          "properties": {
            "filePath": {"type": "string"},
            "fileName": {"type": "string"},
            "startLine": {"type": "integer"},
            "endLine": {"type": "integer"}
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "所在文件": {"type": "string"},
            "角色能力": {"type": "string"},
            "任务请求": {"type": "string"},
            "背景情境": {"type": "string"},
            "指令行动": {"type": "string"},
            "输入格式": {"type": "string"},
            "输出规格": {"type": "string"},
            "示例": {"type": "string"},
            "限制约束": {"type": "string"},
            "目标期望": {"type": "string"},
            "信息": {"type": "string"},
            "评估优化": {"type": "string"},
            "调整": {"type": "string"},
            "受众": {"type": "string"},
            "风格要求": {"type": "string"}
          }
        },
        "qualityMetrics": {
          "type": "object",
          "properties": {
            "overallConfidence": {"type": "number"},
            "completenessScore": {"type": "number"},
            "elementsFound": {"type": "integer"}
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "category": {"type": "string"},
            "tags": {"type": "array", "items": {"type": "string"}},
            "complexity": {"type": "number"},
            "language": {"type": "string"},
            "wordCount": {"type": "integer"}
          }
        }
      },
      "required": ["promptId", "name", "originalContent", "analysis"]
    },
    
    "ReportOptions": {
      "type": "object",
      "properties": {
        "reportType": {
          "type": "string",
          "enum": ["summary", "detailed", "executive"],
          "default": "summary",
          "description": "报告类型"
        },
        "includeStatistics": {
          "type": "boolean",
          "default": true,
          "description": "是否包含统计信息"
        },
        "includeCharts": {
          "type": "boolean",
          "default": false,
          "description": "是否包含图表(仅HTML格式)"
        },
        "includeRawData": {
          "type": "boolean",
          "default": false,
          "description": "是否包含原始数据"
        },
        "groupBy": {
          "type": "string",
          "enum": ["category", "file", "complexity", "none"],
          "default": "none",
          "description": "分组方式"
        },
        "sortBy": {
          "type": "string",
          "enum": ["name", "confidence", "completeness", "complexity"],
          "default": "name",
          "description": "排序方式"
        },
        "filterCriteria": {
          "type": "object",
          "properties": {
            "minConfidence": {"type": "number"},
            "minCompleteness": {"type": "number"},
            "categories": {"type": "array", "items": {"type": "string"}},
            "tags": {"type": "array", "items": {"type": "string"}}
          },
          "description": "过滤条件"
        },
        "customFields": {
          "type": "array",
          "items": {"type": "string"},
          "description": "自定义要包含的字段"
        }
      }
    },
    
    "TableOptions": {
      "type": "object",
      "properties": {
        "tableType": {
          "type": "string",
          "enum": ["element_comparison", "quality_comparison", "metadata_comparison"],
          "default": "element_comparison",
          "description": "表格类型"
        },
        "layout": {
          "type": "string",
          "enum": ["prompts_as_rows", "prompts_as_columns"],
          "default": "prompts_as_rows",
          "description": "表格布局"
        },
        "includedElements": {
          "type": "array",
          "items": {"type": "string"},
          "description": "要包含的分析要素"
        },
        "showEmptyCells": {
          "type": "boolean",
          "default": true,
          "description": "是否显示空单元格"
        },
        "highlightMissing": {
          "type": "boolean",
          "default": true,
          "description": "是否高亮缺失的要素"
        },
        "enableSorting": {
          "type": "boolean",
          "default": true,
          "description": "是否启用排序功能(HTML格式)"
        },
        "enableFiltering": {
          "type": "boolean",
          "default": false,
          "description": "是否启用过滤功能(HTML格式)"
        },
        "cellMaxLength": {
          "type": "integer",
          "default": 200,
          "description": "单元格内容最大长度"
        },
        "tableTitle": {
          "type": "string",
          "description": "表格标题"
        }
      }
    },
    
    "ExportOptions": {
      "type": "object",
      "properties": {
        "outputPath": {
          "type": "string",
          "description": "输出文件路径"
        },
        "fileName": {
          "type": "string",
          "description": "文件名(不含扩展名)"
        },
        "overwrite": {
          "type": "boolean",
          "default": false,
          "description": "是否覆盖已存在文件"
        },
        "compression": {
          "type": "boolean",
          "default": false,
          "description": "是否压缩输出"
        },
        "encoding": {
          "type": "string",
          "default": "utf-8",
          "description": "文件编码"
        },
        "formatSpecific": {
          "type": "object",
          "description": "格式特定选项",
          "properties": {
            "html": {
              "type": "object",
              "properties": {
                "theme": {"type": "string", "enum": ["default", "dark", "minimal"]},
                "includeCSS": {"type": "boolean", "default": true},
                "includeJS": {"type": "boolean", "default": true},
                "responsive": {"type": "boolean", "default": true}
              }
            },
            "pdf": {
              "type": "object",
              "properties": {
                "pageSize": {"type": "string", "enum": ["A4", "Letter", "A3"]},
                "orientation": {"type": "string", "enum": ["portrait", "landscape"]},
                "margin": {"type": "string"}
              }
            },
            "csv": {
              "type": "object",
              "properties": {
                "delimiter": {"type": "string", "default": ","},
                "quote": {"type": "string", "default": "\""},
                "escape": {"type": "string", "default": "\\"},
                "includeHeaders": {"type": "boolean", "default": true}
              }
            }
          }
        }
      }
    },
    
    "StatisticsOptions": {
      "type": "object",
      "properties": {
        "includeBasicStats": {
          "type": "boolean",
          "default": true,
          "description": "包含基础统计"
        },
        "includeElementAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "包含要素分析"
        },
        "includeQualityAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "包含质量分析"
        },
        "includeDistributions": {
          "type": "boolean",
          "default": true,
          "description": "包含分布统计"
        },
        "calculateCorrelations": {
          "type": "boolean",
          "default": false,
          "description": "计算要素相关性"
        }
      }
    },
    
    "ReportResult": {
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "description": "报告ID"
        },
        "reportType": {
          "type": "string",
          "description": "报告类型"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "生成时间"
        },
        "summary": {
          "$ref": "#/definitions/ReportSummary"
        },
        "sections": {
          "type": "array",
          "items": {"$ref": "#/definitions/ReportSection"},
          "description": "报告章节"
        },
        "statistics": {
          "$ref": "#/definitions/ReportStatistics"
        },
        "metadata": {
          "$ref": "#/definitions/ReportMetadata"
        }
      },
      "required": ["reportId", "reportType", "generatedAt", "summary"]
    },
    
    "ReportSummary": {
      "type": "object",
      "properties": {
        "totalPrompts": {"type": "integer"},
        "totalFiles": {"type": "integer"},
        "averageConfidence": {"type": "number"},
        "averageCompleteness": {"type": "number"},
        "highQualityPrompts": {"type": "integer"},
        "languageDistribution": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "categoryDistribution": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "topMissingElements": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    
    "ReportSection": {
      "type": "object",
      "properties": {
        "sectionId": {"type": "string"},
        "title": {"type": "string"},
        "content": {"type": "string"},
        "charts": {
          "type": "array",
          "items": {"$ref": "#/definitions/ChartData"}
        },
        "tables": {
          "type": "array",
          "items": {"$ref": "#/definitions/TableData"}
        }
      }
    },
    
    "ChartData": {
      "type": "object",
      "properties": {
        "chartId": {"type": "string"},
        "chartType": {"type": "string", "enum": ["bar", "pie", "line", "scatter"]},
        "title": {"type": "string"},
        "data": {"type": "object"},
        "options": {"type": "object"}
      }
    },
    
    "TableResult": {
      "type": "object",
      "properties": {
        "tableId": {
          "type": "string",
          "description": "表格ID"
        },
        "title": {
          "type": "string",
          "description": "表格标题"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "生成时间"
        },
        "tableData": {
          "$ref": "#/definitions/TableData"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "rowCount": {"type": "integer"},
            "columnCount": {"type": "integer"},
            "emptyCount": {"type": "integer"},
            "completenessRate": {"type": "number"}
          }
        }
      },
      "required": ["tableId", "title", "tableData"]
    },
    
    "TableData": {
      "type": "object", 
      "properties": {
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {"type": "string"},
              "label": {"type": "string"},
              "type": {"type": "string"},
              "sortable": {"type": "boolean"}
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "cells": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "value": {},
                    "displayValue": {"type": "string"},
                    "isEmpty": {"type": "boolean"},
                    "confidence": {"type": "number"},
                    "tooltip": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    
    "ExportResult": {
      "type": "object",
      "properties": {
        "exportId": {
          "type": "string",
          "description": "导出任务ID"
        },
        "format": {
          "type": "string",
          "description": "导出格式"
        },
        "filePath": {
          "type": "string",
          "description": "输出文件路径"
        },
        "fileSize": {
          "type": "integer",
          "description": "文件大小(字节)"
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time",
          "description": "导出完成时间"
        },
        "processingTime": {
          "type": "integer",
          "description": "处理时间(毫秒)"
        },
        "success": {
          "type": "boolean",
          "description": "是否导出成功"
        },
        "errorMessage": {
          "type": "string",
          "description": "错误信息(如果失败)"
        }
      },
      "required": ["exportId", "format", "success"]
    },
    
    "StatisticsResult": {
      "type": "object",
      "properties": {
        "statisticsId": {"type": "string"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "basicStatistics": {
          "type": "object",
          "properties": {
            "totalPrompts": {"type": "integer"},
            "totalFiles": {"type": "integer"},
            "averageLength": {"type": "number"},
            "averageWordCount": {"type": "number"},
            "languageDistribution": {"type": "object"}
          }
        },
        "elementStatistics": {
          "type": "object",
          "properties": {
            "elementCoverage": {
              "type": "object",
              "additionalProperties": {"type": "number"}
            },
            "averageElementLength": {
              "type": "object",
              "additionalProperties": {"type": "number"}
            },
            "elementQuality": {
              "type": "object",
              "additionalProperties": {"type": "number"}
            }
          }
        },
        "qualityStatistics": {
          "type": "object",
          "properties": {
            "averageConfidence": {"type": "number"},
            "averageCompleteness": {"type": "number"},
            "qualityDistribution": {
              "type": "object",
              "properties": {
                "high": {"type": "integer"},
                "medium": {"type": "integer"},
                "low": {"type": "integer"}
              }
            }
          }
        },
        "correlations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "element1": {"type": "string"},
              "element2": {"type": "string"},
              "correlation": {"type": "number"},
              "significance": {"type": "number"}
            }
          }
        }
      }
    },
    
    "ReportData": {
      "type": "object",
      "properties": {
        "reportContent": {"type": "string"},
        "dataFormat": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "required": ["reportContent"]
    },
    
    "ReportStatistics": {
      "type": "object",
      "properties": {
        "processingTime": {"type": "integer"},
        "dataPoints": {"type": "integer"},
        "sectionsGenerated": {"type": "integer"},
        "tablesGenerated": {"type": "integer"},
        "chartsGenerated": {"type": "integer"}
      }
    },
    
    "ReportMetadata": {
      "type": "object",
      "properties": {
        "generatorVersion": {"type": "string"},
        "templateVersion": {"type": "string"},
        "dataVersion": {"type": "string"},
        "generationOptions": {"type": "object"}
      }
    }
  }
}