{
  "name": "prompt-analyzer",
  "version": "0.1.0",
  "description": "AI提示词分析工作流 - 智能识别和分析代码仓库中的提示词内容",
  "main": "dist/cli/main.js",
  "bin": {
    "prompt-analyzer": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest tests/contract",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "prompt",
    "analysis",
    "cli",
    "typescript",
    "gpt",
    "prompt-engineering"
  ],
  "author": "Michael Peng",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael1Peng/prompt-comparison.git"
  },
  "bugs": {
    "url": "https://github.com/Michael1Peng/prompt-comparison/issues"
  },
  "homepage": "https://github.com/Michael1Peng/prompt-comparison#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "fast-glob": "^3.3.3",
    "glob": "^11.0.3",
    "openai": "^5.20.2",
    "ora": "^8.2.0",
    "p-limit": "^7.1.1",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
