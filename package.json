{
  "name": "prompt-comparison-spec-kit",
  "version": "1.0.0",
  "description": "AI代理工作流系统，用于分析代码仓库中的提示词",
  "main": "dist/cli.js",
  "bin": {
    "prompt-analyzer": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\"",
    "clean": "rimraf dist"
  },
  "keywords": [
    "prompt",
    "analysis",
    "ai",
    "workflow",
    "cli",
    "comparison"
  ],
  "author": "Michael1Peng",
  "license": "MIT",
  "dependencies": {
    "@types/cosmiconfig": "^5.0.3",
    "@types/uuid": "^10.0.0",
    "chalk": "^5.6.2",
    "cosmiconfig": "^9.0.0",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "ignore": "^7.0.5",
    "ora": "^8.2.0",
    "uuid": "^13.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.6",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitest/coverage-v8": "^1.1.3",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module"
}
